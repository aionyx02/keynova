{
  "name": "tauri-app",
  "private": true,
  "version": "0.4.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "clean:local": "node scripts/clean-local-artifacts.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:icon": "tauri icon src/assets/keynova_icon.png",
    "keynova": "cargo run --manifest-path src-tauri/Cargo.toml --bin keynova --",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "guard:size": "node scripts/code-guard-size.mjs",
    "bench:ai": "node scripts/bench-ai-capability.mjs",
    "verify": "npm run docs:refresh && npm run check && npm run test && npm run rust:test && npm run rust:clippy && npm run guard:size",
    "docs:sync": "node scripts/docs-sync.mjs",
    "docs:guard": "node scripts/docs-guard.mjs",
    "docs:guard-size": "node scripts/docs-guard-size.mjs",
    "docs:guard-schema": "node scripts/docs-guard-schema.mjs",
    "docs:audit-frontmatter": "node scripts/docs-audit-frontmatter.mjs",
    "docs:narrative-check": "node scripts/docs-narrative-check.mjs",
    "docs:new-session": "node scripts/docs-new-session.mjs",
    "docs:extract-narrative": "node scripts/docs-extract-narrative.mjs",
    "docs:completed-regen": "node scripts/docs-completed-regen.mjs",
    "docs:archive-sessions": "node scripts/docs-archive-sessions.mjs",
    "docs:workbench-sync": "node scripts/docs-workbench-sync.mjs",
    "docs:workbench-guard": "node scripts/docs-workbench-guard.mjs",
    "docs:refresh": "npm run docs:workbench-sync && npm run docs:workbench-guard && npm run docs:sync && npm run docs:guard-size && npm run docs:guard-schema && npm run docs:audit-frontmatter && npm run docs:narrative-check && npm run docs:guard",
    "hooks:install": "node scripts/install-githooks.mjs",
    "prepare": "npm run hooks:install"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^9.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.13",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
